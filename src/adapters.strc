# adapters — data backends: local demo, fediverse (real), instagram (experimental)
#
# Every adapter fills the same types.strc models, so screens are
# backend-agnostic. Selection lives in Settings -> Account.
#
# * local      — bundled demo dataset (offline, always works)
# * fediverse  — LIVE public timelines from open Mastodon/Pixelfed instances
#                via the documented /api/v1/timelines/public endpoint. No
#                login needed on instances that allow public access; an
#                access token can be pasted for instances that require one.
# * instagram  — EXPERIMENTAL, opt-in. Talks to Instagram's private mobile
#                API (i.instagram.com/api/v1) the same way instagrapi does:
#                you paste the sessionid cookie from a logged-in browser and
#                the client presents it on every request. Instagram does not
#                offer an official API for third-party clients anymore (the
#                Basic Display API shut down in Dec 2024), so this mode:
#                  - violates Instagram's Terms of Service,
#                  - can get your account rate-limited or banned,
#                  - may break without notice when Instagram changes.
#                Read-mostly by design (profile, posts, stories tray). Use
#                at your own risk with an account you can afford to lose.

use net
use json
use "src/types.strc": User, Post
use "src/storage.strc": strip_html
use "src/theme.strc"

type FetchResult:
    ok: bool
    data: any
    error: str

type ProfileResult:
    ok: bool
    user: User
    posts: [Post]

type FeedResult:
    ok: bool
    users: [User]
    posts: [Post]

type Adapter:
    mode: str                       # "local" | "fediverse" | "instagram"
    instance: str = "mastodon.world"
    token: str = ""                 # fediverse access token (optional)
    ig_sessionid: str = ""          # instagram sessionid cookie (experimental)
    ig_ds_user_id: str = ""         # derived from sessionid digits
    status: str = ""                # last status line for the UI
    last_error: str = ""

func make_adapter(mode: str) -> Adapter:
    return Adapter(mode)

# --------------------------------------------------------------- local demo

func load_local(users_in: [User]) -> ([User], [Post], [NoteItem], [Reel]):
    users = demo_users()
    posts = demo_posts(users)
    notes = demo_notes(users)
    reels = demo_reels(users)
    return (users, posts, notes, reels)

# ---------------------------------------------------------------- fediverse
# Open instances known to allow (or likely to allow) anonymous public
# timeline reads. The first one that answers wins; a user-provided instance
# and token take priority.

FEDI_INSTANCES = ["mastodon.world", "fosstodon.org", "mas.to", "mastodon.social"]

func fedi_user_agent() -> str:
    return "Wingram/0.1 (Still desktop client; +https://github.com/StillAdum/wingram)"

func fedi_fetch_timeline(a: Adapter, limit: int) -> FetchResult:
    order = [a.instance]
    for inst in FEDI_INSTANCES:
        if inst != a.instance:
            push(order, inst)
    last_err = ""
    for inst in order:
        if inst == "":
            continue
        url = "https://{inst}/api/v1/timelines/public?limit={limit}"
        headers = "User-Agent: {fedi_user_agent()}\nAccept: application/json"
        if a.token != "":
            headers = headers + "\nAuthorization: Bearer {a.token}"
        r = net.get(url, headers, 15000)
        if not r.ok:
            last_err = "{inst}: {r.error}"
            continue
        if r.status == 401 or r.status == 403:
            last_err = "{inst} requires an access token"
            continue
        res = json.parse(r.body)
        if not res.ok:
            last_err = "{inst}: bad JSON ({res.error})"
            continue
        if type_of(res.value) != "list":
            # {"error": "..."} shape
            last_err = "{inst}: {json.get_str(res.value, "error", "unexpected response")}"
            continue
        a.instance = inst
        a.status = "live from {inst}"
        return FetchResult(true, res.value, "")
    a.last_error = last_err
    a.status = "fediverse unavailable"
    return FetchResult(false, none, last_err)

func fedi_map_statuses(statuses: any, out_users: [User]) -> FeedResult:
    # returns (posts, users) — users grows with accounts seen in the timeline
    posts: [Post] = []
    users = out_users
    n = len(statuses)
    for i in range(n):
        s = statuses[i]
        acct = json.get_dict(s, "account")
        sid = json.get_str(s, "id", "{i}")
        aid = json.get_str(acct, "id", sid)
        username = json.get_str(acct, "acct", "unknown")
        display = json.get_str(acct, "display_name", username)
        uid = "fv:{aid}"
        u = find_or_make_user(users, uid, username, display,
            strip_html(json.get_str(acct, "note", "")))
        content = strip_html(json.get_str(s, "content", ""))
        if content == "":
            content = "(media post)"
        created = json.get_str(s, "created_at", "")
        label = time_label_from_iso(created)
        pid = "fv:{sid}"
        seed = "{i}"
        purl = json.get_str(s, "url", "")
        p = Post(
            pid,
            u,
            content,
            json.get_int(s, "favourites_count", 0),
            json.get_int(s, "replies_count", 0),
            label,
            false, false, "gradient", seed, "", "fediverse", purl)
        push(posts, p)
    return FeedResult(true, users, posts)

func find_or_make_user(users: [User], uid: str, username: str, display: str, bio: str) -> User:
    for u in users:
        if u.id == uid:
            return u
    u2 = User(uid, username, display, "initials", username, bio, 0, 0, false, false)
    push(users, u2)
    return u2

# "2026-11-19T18:33:33.000Z" -> a friendly relative label
func time_label_from_iso(iso: str) -> str:
    if len(iso) < 10:
        return ""
    year = iso[0:4]
    today = clock_today_iso()
    if year != today:
        return "{year}"
    hh = iso[11:13]
    mm = iso[14:16]
    return "{hh}:{mm}"

func clock_today_iso() -> str:
    # still's clock() returns unix seconds; derive a stable "this year" tag
    t = clock()
    years = 1970 + int(t / 31556952.0)
    return "{years}"

# ---------------------------------------------------------------- instagram
# Experimental sessionid-based read-only client, mirroring instagrapi's
# login_by_sessionid flow: sessionid -> ds_user_id (leading digits), then
# requests carry the session cookie plus the app headers.

IG_APP_ID = "936619743392459"
IG_UA = "Instagram 219.0.0.12.117 Android (26/8.0.0; 480dpi; 1080x1920; samsung; SM-G960F; dreamltexx; sdm845; en_US; 269990621)"

func ig_extract_user_id(sessionid: str) -> str:
    # instagrapi: the leading digits of the sessionid are the user id
    out = ""
    for i in range(len(sessionid)):
        c = sessionid[i]
        if c >= "0" and c <= "9":
            out += c
        else:
            break
    return out

func ig_headers(a: Adapter) -> str:
    h = "User-Agent: {IG_UA}\nX-IG-App-ID: {IG_APP_ID}\nAccept: */*\n"
    h = h + "Cookie: sessionid={a.ig_sessionid}; ds_user_id={a.ig_ds_user_id}"
    if a.ig_ds_user_id != "":
        h = h + "\nIG-INTENDED-USER-ID: {a.ig_ds_user_id}"
    return h

func ig_get(a: Adapter, path: str) -> FetchResult:
    if a.ig_sessionid == "":
        a.last_error = "no sessionid configured (Settings -> Account)"
        return FetchResult(false, none, a.last_error)
    r = net.get("https://i.instagram.com{path}", ig_headers(a), 20000)
    if not r.ok:
        a.last_error = r.error
        return FetchResult(false, none, a.last_error)
    if r.status != 200:
        a.last_error = "instagram returned {r.status} (login expired? banned? rate limited?)"
        return FetchResult(false, none, a.last_error)
    res = json.parse(r.body)
    if not res.ok:
        a.last_error = "instagram sent invalid JSON"
        return FetchResult(false, none, a.last_error)
    a.status = "instagram session active"
    return FetchResult(true, res.value, "")

func ig_fetch_profile(a: Adapter, username: str, users: [User]) -> ProfileResult:
    f1 = ig_get(a, "/api/v1/users/web_profile_info/?username={username}")
    data = f1.data
    if not f1.ok:
        # web_profile_info wants the web app id; fall back to private user info
        f2 = ig_get(a, "/api/v1/users/usernameinfo/?username={username}")
        if not f2.ok:
            return ProfileResult(false, User("", "", "", "initials", "", "", 0, 0, false, false), [])
        data = f2.data
    user_node = json.get_dict(data, "user")
    if user_node is none:
        user_node = data
    upk = json.get_str(user_node, "pk", json.get_str(user_node, "id", username))
    uid = "ig:{upk}"
    u = User(
        uid,
        json.get_str(user_node, "username", username),
        json.get_str(user_node, "full_name", username),
        "initials", username,
        strip_html(json.get_str(user_node, "biography", "")),
        json.get_int(user_node, "follower_count", 0),
        json.get_int(user_node, "following_count", 0),
        json.get_bool(user_node, "is_verified", false),
        false)
    push(users, u)
    posts: [Post] = []
    # user feed (12 most recent). Endpoints drift; failure is non-fatal.
    ff = ig_get(a, "/api/v1/feed/user/{upk}/")
    if ff.ok:
        items = json.get_list(ff.data, "items")
        for i in range(len(items)):
            it = items[i]
            media = json.get_dict(it, "media")
            if media is none:
                media = it
            mid = json.get_str(media, "id", "{i}")
            pid = "ig:{mid}"
            cap = json.get_dict(media, "caption")
            cap_text = json.get_str(cap, "text", "(no caption)")
            seed = "{i}"
            p = Post(
                pid,
                u,
                cap_text,
                json.get_int(media, "like_count", 0),
                json.get_int(media, "comment_count", 0),
                "",
                false, false, "gradient", seed, "", "instagram", "")
            push(posts, p)
    return ProfileResult(true, u, posts)

# ------------------------------------------------------------- dispatch

func refresh_feed(a: Adapter, target_username: str) -> FeedResult:
    if a.mode == "fediverse":
        fr = fedi_fetch_timeline(a, 20)
        if fr.ok:
            mapped = fedi_map_statuses(fr.data, [])
            return FeedResult(true, mapped.users, mapped.posts)
        return FeedResult(false, [], [])
    if a.mode == "instagram":
        pr = ig_fetch_profile(a, target_username, [])
        if pr.ok:
            return FeedResult(true, [pr.user], pr.posts)
        return FeedResult(false, [], [])
    # local
    users = demo_users()
    posts = demo_posts(users)
    return FeedResult(true, users, posts)
