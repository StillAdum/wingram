# screen_feed — the home feed: notes tray (with songs), real posts
#
# Layout follows instagram.com web: a centered ~630px column with the notes
# tray on top (Wingram's songs-in-notes feature lives here), then post cards
# with real images, like counts and captions. The left nav rail is drawn by
# the main loop. Posts come from the logged-in account's real timeline.

use gui
use media
use "src/theme.strc"
use "src/types.strc": User, Post, NoteItem, count_format
use "src/songs.strc"
use "src/ui_kit.strc"
use "src/imagepipe.strc"
use "src/app.strc"
use "src/adapters.strc": refresh_feed

func render(app: App) -> App:
    win = app.win
    t = app.theme
    s = app.scale
    top = 10.0 * s
    app = render_notes_tray(app, top)
    top = top + 84.0 * s
    app = render_posts(app, top)
    return app

# ------------------------------------------------------------- notes tray
# Own note bubbles (notes are a personal feature: text + optional song that
# previews with the built-in synth).

func render_notes_tray(app: App, y: float) -> App:
    win = app.win
    t = app.theme
    s = app.scale
    x0 = 28.0 * s
    cx = x0 + 26.0 * s
    draw_add_note(app, cx, y + 30.0 * s)
    cx = cx + 60.0 * s
    for i in range(len(app.notes)):
        n = app.notes[i]
        u = n.user
        rad = 22.0 * s
        imagepipe.draw_avatar(app, u, cx, y + 30.0 * s, rad, false, false)
        bubble_w = bubble_width(n, s)
        bx = cx - bubble_w / 2.0
        by = y - 6.0 * s
        bcol = t.note_other
        if u.is_self:
            bcol = t.note_self
        gui.fill_round(win, bx, by, bubble_w, 32.0 * s, 16.0 * s, bcol)
        gui.clip_push(win, bx + 2.0 * s, by, bubble_w - 4.0 * s, 32.0 * s)
        if n.song_id != "":
            song = app.catalog.find(n.song_id)
            icon_music(win, t, bx + 8.0 * s, by + 8.0 * s, 13.0 * s, t.sticker_b)
            gui.text_bold(win, bx + 24.0 * s, by + 8.0 * s, song.title, t.text, 12.0 * s)
        else:
            gui.text(win, bx + 12.0 * s, by + 8.0 * s, n.text, t.text, 12.0 * s)
        gui.clip_pop(win)
        if click_zone(win, bx, by, bubble_w, 32.0 * s):
            if n.song_id != "":
                if app.preview_song == n.song_id and app.preview_playing:
                    stop_preview()
                    app.preview_playing = false
                    app.preview_song = ""
                    app.toast_for("preview stopped", 1.5)
                elif play_preview(app.catalog, n.song_id):
                    app.preview_song = n.song_id
                    app.preview_playing = true
                    song = app.catalog.find(n.song_id)
                    app.toast_for("playing {song.title} — {song.artist}", 2.5)
                else:
                    app.toast_for("audio backend unavailable (needs Windows)", 2.5)
            else:
                app.toast_for(n.text, 2.0)
        cx = cx + 60.0 * s
    return app

func bubble_width(n: NoteItem, s: float) -> float:
    w = 44.0 * s
    if n.song_id != "":
        w = 118.0 * s
    else:
        w = float(len(n.text)) * 7.0 * s + 22.0 * s
    if w > 150.0 * s:
        w = 150.0 * s
    if w < 48.0 * s:
        w = 48.0 * s
    return w

func draw_add_note(app: App, cx: float, cy: float):
    win = app.win
    t = app.theme
    s = app.scale
    imagepipe.draw_avatar(app, app.me, cx, cy, 22.0 * s, false, false)
    gui.text(win, cx - 22.0 * s, cy + 30.0 * s, "your note", t.text_dim, 11.0 * s)
    if click_zone(win, cx - 24.0 * s, cy - 24.0 * s, 48.0 * s, 62.0 * s):
        app.screen = "notes"
        app.picker_open = false
        app.compose_text = ""
        app.compose_song = ""
        app.compose_focus = false

# ------------------------------------------------------------- post cards

func render_posts(app: App, top: float) -> App:
    win = app.win
    t = app.theme
    s = app.scale
    gw = float(gui.width(win))
    gh = float(gui.height(win))
    w = float(t.center_w) * s
    x0 = (gw - w) / 2.0 + 12.0 * s
    y = top + 6.0 * s
    content_h = float(len(app.posts)) * card_height(s) + 40.0 * s
    if app.feed_more:
        content_h = content_h + 60.0 * s
    view_h = gh - y - 12.0 * s
    if view_h < 0.0:
        view_h = 0.0
    offset = float(app.scroll_of("feed"))
    max_off = content_h - view_h
    if max_off < 0.0:
        max_off = 0.0
    wheel = gui.wheel_delta(win)
    if wheel != 0:
        offset = offset - float(wheel) * 1.4
    if offset < 0.0:
        offset = 0.0
    if offset > max_off:
        offset = max_off
    app.set_scroll("feed", int(offset))

    gui.clip_push(win, x0, y, w, view_h)
    cy = y - offset
    for i in range(len(app.posts)):
        p = app.posts[i]
        h = card_height(s)
        if cy + h >= y and cy <= y + view_h:
            render_post_card(app, p, i, x0, cy, w)
        cy = cy + h + 24.0 * s
    gui.clip_pop(win)

    # footer: load more / end of feed
    if app.feed_more and app.fetch_state == "ok":
        by = y + view_h - 44.0 * s
        if draw_button(win, t, x0 + w / 2.0 - 80.0 * s, by, 160.0 * s, 34.0 * s, "load more", false):
            app.feed_loading_more = true
    return app

func card_height(s: float) -> float:
    return 44.0 * s + 470.0 * s + 92.0 * s

func render_post_card(app: App, p: Post, idx: int, x: float, y: float, w: float) -> App:
    win = app.win
    t = app.theme
    s = app.scale
    # header
    imagepipe.draw_avatar(app, p.user, x + 20.0 * s, y + 20.0 * s, 15.0 * s, false, false)
    draw_username(win, t, p.user, x + 44.0 * s, y + 12.0 * s, 14.0 * s)
    if click_zone(win, x, y, w, 40.0 * s):
        app.screen = "profile"
        app.profile_owner = p.user.username
        app.set_scroll("profile", 0)
        app.profile_error = ""
    tag = ""
    if p.video:
        tag = "video"
    elif p.album:
        tag = "album"
    if tag != "" and p.time_label != "":
        tag = "{tag} • "
    if tag != "":
        gui.text(win, x + 44.0 * s + float(gui.text_width(win, p.user.username, 14.0 * s)) + 10.0 * s, y + 14.0 * s, "{tag}{p.time_label}", t.text_dim, 13.0 * s)
    # media
    mx = x
    my = y + 44.0 * s
    mh = 470.0 * s
    imagepipe.draw(app, p.photo_arg, mx, my, w, mh)
    if p.video:
        # play badge
        bw2 = 54.0 * s
        gui.fill_round(win, mx + w / 2.0 - bw2 / 2.0, my + mh / 2.0 - bw2 / 2.0, bw2, bw2, 12.0 * s, lerp_color(0x000000, 0xFFFFFF, 0.18))
        gui.fill_rect(win, mx + w / 2.0 - 8.0 * s, my + mh / 2.0 - 12.0 * s, 3.0 * s, 24.0 * s, 0xFFFFFF)
        gui.fill_rect(win, mx + w / 2.0 + 4.0 * s, my + mh / 2.0 - 12.0 * s, 3.0 * s, 24.0 * s, 0xFFFFFF)
    # action row
    ay = my + mh + 10.0 * s
    ax = x + 12.0 * s
    like_col = t.text
    if p.liked:
        like_col = t.like
    icon_heart(win, t, ax, ay, 24.0 * s, like_col)
    if click_zone(win, ax - 4.0 * s, ay - 4.0 * s, 32.0 * s, 32.0 * s):
        app = toggle_like(app, idx)
    icon_comment(win, t, ax + 34.0 * s, ay, 24.0 * s, t.text)
    if click_zone(win, ax + 30.0 * s, ay - 4.0 * s, 32.0 * s, 32.0 * s):
        app.toast_for("comments are read-only in this build", 2.0)
    icon_send(win, t, ax + 68.0 * s, ay, 24.0 * s, t.text)
    if click_zone(win, ax + 64.0 * s, ay - 4.0 * s, 32.0 * s, 32.0 * s):
        app.toast_for("sharing arrives in a later build", 2.0)
    save_x = x + w - 36.0 * s
    icon_bookmark(win, t, save_x, ay, 24.0 * s, p.saved, t.text)
    if click_zone(win, save_x - 4.0 * s, ay - 4.0 * s, 32.0 * s, 32.0 * s):
        p.saved = not p.saved
        app.posts[idx] = p
    # likes + caption
    ly = ay + 32.0 * s
    gui.text_bold(win, x + 12.0 * s, ly, "{count_format(p.likes)} likes", t.text, 14.0 * s)
    if p.caption != "":
        gui.clip_push(win, x, ly + 20.0 * s, w, 22.0 * s)
        gui.text(win, x + 12.0 * s, ly + 22.0 * s, "{p.user.username}  {p.caption}", t.text, 13.0 * s)
        gui.clip_pop(win)
    if p.song_id != "":
        song = app.catalog.find(p.song_id)
        icon_music(win, t, x + 12.0 * s, ly + 46.0 * s, 13.0 * s, t.sticker_b)
        gui.text(win, x + 30.0 * s, ly + 47.0 * s, "{song.artist} • {song.title}", t.text_dim, 12.0 * s)
    return app

func toggle_like(app: App, idx: int) -> App:
    if idx < 0 or idx >= len(app.posts):
        return app
    p = app.posts[idx]
    if p.liked:
        p.liked = false
        p.likes = p.likes - 1
    else:
        p.liked = true
        p.likes = p.likes + 1
    app.posts[idx] = p
    return app
