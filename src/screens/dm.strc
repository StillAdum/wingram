# screen_dm — direct messages
#
# Honest state: Instagram's DM endpoints are GraphQL-only and need more
# than a session cookie to call reliably, so this build does not fake a
# chat. The screen explains that and links to the web inbox instead of
# showing invented conversations.

use gui
use "src/theme.strc"
use "src/ui_kit.strc"
use "src/app.strc"

func render(app: App) -> App:
    win = app.win
    t = app.theme
    s = app.scale
    gw = float(gui.width(win))
    gh = float(gui.height(win))
    cx = gw / 2.0
    cy = gh / 2.0 - 40.0 * s

    gui.fill_round(win, cx - 200.0 * s, cy - 120.0 * s, 400.0 * s, 240.0 * s, 14.0 * s, t.surface)
    gui.fill_round(win, cx - 200.0 * s, cy - 120.0 * s, 400.0 * s, 4.0 * s, 2.0 * s, t.accent)
    gui.text_bold(win, cx - 160.0 * s, cy - 84.0 * s, "Direct messages", t.text, 20.0 * s)
    lines = [
        "DMs need Instagram's GraphQL endpoints, which this build",
        "does not implement yet — and fake chats would be worse than",
        "none. Your real inbox is one click away meanwhile:"
    ]
    ly = cy - 48.0 * s
    for i in range(len(lines)):
        gui.text(win, cx - 160.0 * s, ly + float(i) * 22.0 * s, lines[i], t.text_dim, 13.0 * s)
    ly = ly + 78.0 * s
    if draw_button(win, t, cx - 160.0 * s, ly, 200.0 * s, 36.0 * s, "open instagram.com/direct", true):
        app.toast_for("open https://www.instagram.com/direct in your browser", 3.5)
    gui.text(win, cx - 160.0 * s, ly + 48.0 * s, "(copy it from the toast, or your browser's address bar)", t.text_faint, 11.0 * s)
    return app
