# screen_settings — settings incl. the Mods section
#
# Sections: Account (session info + logout, optional fediverse backend),
# Appearance (theme info), Mods (list .strc mods with enable toggles +
# reload), About. Changes persist to config.ini; mods hot-reload.

use gui
use webview
use "src/theme.strc"
use "src/types.strc": User
use "src/ui_kit.strc"
use "src/app.strc"
use "src/adapters.strc"
use "src/mods_engine.strc"
use "src/storage.strc"

func render(app: App) -> App:
    win = app.win
    t = app.theme
    s = app.scale
    x0 = 28.0 * s
    y = 18.0 * s
    gui.text_bold(win, x0, y, "Settings", t.text, 24.0 * s)
    y = y + 50.0 * s
    app = render_account_section(app, x0, y)
    y = y + 170.0 * s
    app = render_mods_section(app, x0, y)
    y = y + float(len(app.mods.mods)) * 60.0 * s + 120.0 * s
    render_about_section(app, x0, y)
    return app

# ------------------------------------------------------------- account

func render_account_section(app: App, x: float, y: float) -> App:
    win = app.win
    t = app.theme
    s = app.scale
    w = 560.0 * s
    gui.fill_round(win, x, y, w, 150.0 * s, 10.0 * s, t.surface)
    gui.text_bold(win, x + 16.0 * s, y + 14.0 * s, "Account", t.text, 16.0 * s)
    bx = x + 16.0 * s
    by = y + 46.0 * s
    # session line
    gui.text(win, bx, by + 4.0 * s, "instagram:", t.text_dim, 13.0 * s)
    who = "not signed in"
    if app.adapter.ig_sessionid != "":
        who = "@{app.me.username} — session {mask_session(app.adapter.ig_sessionid)}"
    gui.text(win, bx + 90.0 * s, by + 5.0 * s, who, t.text, 13.0 * s)
    if draw_button(win, t, bx + 420.0 * s, by - 4.0 * s, 120.0 * s, 32.0 * s, "log out", false):
        app = do_logout(app)
    # fediverse instance field (secondary backend)
    gui.text(win, bx, by + 44.0 * s, "fediverse:", t.text_dim, 13.0 * s)
    inst = app.settings_cfg.get("account.fediverse_instance", app.adapter.instance)
    buf, f = text_input_box(win, t, bx + 90.0 * s, by + 38.0 * s, 200.0 * s, 30.0 * s, inst, app.settings_focus == "instance", "mastodon.world")
    if app.settings_focus == "instance":
        app.settings_cfg["account.fediverse_instance"] = apply_typed(win, buf, true)
        app.adapter.instance = app.settings_cfg["account.fediverse_instance"]
    elif f:
        app.settings_focus = "instance"
    if draw_button(win, t, bx + 300.0 * s, by + 36.0 * s, 120.0 * s, 32.0 * s, "use fediverse", false):
        if app.adapter.mode != "fediverse":
            app.adapter.mode = "fediverse"
            app.settings_cfg["account.backend"] = "fediverse"
            app.reload_requested = true
    # backend status + switch back
    mode_label = "reading instagram as @{app.me.username}"
    if app.adapter.mode == "fediverse":
        mode_label = "reading the fediverse ({app.adapter.instance})"
    gui.text(win, bx, by + 82.0 * s, "status: {mode_label} — {app.adapter.status}", t.text_dim, 12.0 * s)
    if app.adapter.mode == "fediverse":
        if draw_button(win, t, bx + 420.0 * s, by + 76.0 * s, 120.0 * s, 32.0 * s, "use instagram", false):
            app.adapter.mode = "instagram"
            app.settings_cfg["account.backend"] = "instagram"
            app.reload_requested = true
    return app

func do_logout(app: App) -> App:
    app.adapter.ig_sessionid = ""
    app.adapter.ig_ds_user_id = ""
    app.adapter.ig_csrftoken = ""
    app.logged_in = false
    app.me = User("", "", "", "initials", "", "", 0, 0, false, true)
    app.posts = []
    app.users = []
    app.notifs = []
    app.profile_posts = []
    app.profile_user = User("", "", "", "initials", "", "", 0, 0, false, false)
    app.profile_owner = ""
    app.notif_state = "idle"
    app.fetch_state = "idle"
    app.settings_cfg["account.instagram_sessionid"] = ""
    app.settings_cfg["account.instagram_ds_user_id"] = ""
    app.settings_cfg["account.instagram_csrftoken"] = ""
    app.settings_cfg["account.backend"] = "instagram"
    save_config("config.ini", app.mods, app.settings_cfg)
    app.toast_for("logged out — sign in again from the login screen", 3.0)
    return app

func mask_session(s: str) -> str:
    if s == "":
        return "(not set)"
    if len(s) <= 8:
        return "****"
    return "{s[0:4]}...{s[len(s) - 4:]}"

# ------------------------------------------------------------- mods

func render_mods_section(app: App, x: float, y: float) -> App:
    win = app.win
    t = app.theme
    s = app.scale
    w = 560.0 * s
    header_h = 56.0 * s
    rows = len(app.mods.mods)
    box_h = float(rows) * 60.0 * s + header_h + 12.0 * s
    if box_h < 120.0 * s:
        box_h = 120.0 * s
    gui.fill_round(win, x, y, w, box_h, 10.0 * s, t.surface)
    gui.text_bold(win, x + 16.0 * s, y + 14.0 * s, "Mods", t.text, 16.0 * s)
    gui.text(win, x + 80.0 * s, y + 18.0 * s, "drop <modname>.strc files into the mods/ folder", t.text_faint, 12.0 * s)
    n_enabled = app.mods.enabled_count()
    gui.text(win, x + 16.0 * s, y + 36.0 * s, "{n_enabled} of {rows} enabled", t.text_dim, 12.0 * s)
    if draw_button(win, t, x + w - 116.0 * s, y + 12.0 * s, 100.0 * s, 32.0 * s, "reload mods", false):
        app.mods.scan()
        app.mods = apply_config(app.mods, app.settings_cfg)
        app.theme = app.mods.apply_theme(make_theme())
        save_config("config.ini", app.mods, app.settings_cfg)
        app.toast_for("mods reloaded", 2.0)
    ry = y + header_h
    for i in range(rows):
        m = app.mods.mods[i]
        rowy = ry + float(i) * 60.0 * s
        if m.enabled:
            gui.fill_round(win, x + 10.0 * s, rowy, w - 20.0 * s, 54.0 * s, 8.0 * s, t.accent_soft)
        # toggle
        toggled = draw_toggle(win, t, x + 22.0 * s, rowy + 14.0 * s, m.enabled)
        if toggled != m.enabled:
            app.mods.set_enabled(m.id, toggled)
            app.theme = app.mods.apply_theme(make_theme())
            save_config("config.ini", app.mods, app.settings_cfg)
            if toggled:
                app.toast_for("mod on: {m.name}", 2.0)
            else:
                app.toast_for("mod off: {m.name}", 2.0)
        # name + summary
        gui.text_bold(win, x + 70.0 * s, rowy + 8.0 * s, m.name, t.text, 14.0 * s)
        gui.text(win, x + 70.0 * s, rowy + 26.0 * s, m.summary(), t.text_dim, 12.0 * s)
        if m.description != "":
            gui.clip_push(win, x + 70.0 * s, rowy + 42.0 * s, w - 180.0 * s, 12.0 * s)
            gui.text(win, x + 70.0 * s, rowy + 42.0 * s, m.description, t.text_faint, 11.0 * s)
            gui.clip_pop(win)
        # source file chip
        fname = m.file
        if fname.contains("/"):
            fname = fname[find_last_slash(fname) + 1:]
        gui.text(win, x + w - 130.0 * s, rowy + 20.0 * s, fname, t.text_faint, 11.0 * s)
    if rows == 0:
        gui.text(win, x + 16.0 * s, ry + 16.0 * s, "no mods found — create mods/sample.strc and reload", t.text_dim, 13.0 * s)
    return app

func find_last_slash(s: str) -> int:
    idx = -1
    for i in range(len(s)):
        if s[i] == "/":
            idx = i
    return idx

# a switch widget; returns the NEW state (click flips it)
func draw_toggle(win: int, t: Theme, x: float, y: float, on: bool) -> bool:
    w = 44.0
    h = 22.0
    col = t.surface2
    knob_x = x + 2.0
    if on:
        col = t.accent
        knob_x = x + w - 20.0
    gui.fill_round(win, x, y, w, h, float(h / 2.0), col)
    gui.fill_circle(win, knob_x + 9.0, y + float(h) / 2.0, 9.0, t.text)
    clicked = click_zone(win, x - 2.0, y - 2.0, w + 4.0, h + 4.0)
    if clicked:
        return not on
    return on

# ------------------------------------------------------------- about

func render_about_section(app: App, x: float, y: float):
    win = app.win
    t = app.theme
    s = app.scale
    w = 560.0 * s
    gui.fill_round(win, x, y, w, 92.0 * s, 10.0 * s, t.surface)
    gui.text_bold(win, x + 16.0 * s, y + 14.0 * s, "About", t.text, 16.0 * s)
    gui.text(win, x + 16.0 * s, y + 40.0 * s, "Wingram 0.2.0 — a real PC Instagram client written entirely in Still", t.text_dim, 12.0 * s)
    gui.text(win, x + 16.0 * s, y + 58.0 * s, "Still 0.6.6 runtime: gui / net / audio / media / json / webview", t.text_dim, 12.0 * s)
    wv = "webview: {webview.runtime_version()}"
    if not webview.available():
        wv = "webview: unavailable ({webview.last_error()})"
    gui.text(win, x + 16.0 * s, y + 76.0 * s, wv, t.text_faint, 11.0 * s)
    gui.text(win, x + 400.0 * s, y + 76.0 * s, "github.com/StillAdum/wingram", t.accent, 11.0 * s)
