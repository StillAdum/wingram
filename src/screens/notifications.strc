# screen_notifications — activity feed (likes, comments, follows, mentions)

use gui
use "src/theme.strc"
use "src/types.strc": User, Notif
use "src/ui_kit.strc"
use "src/app.strc"
use "src/adapters.strc"

func render(app: App) -> App:
    win = app.win
    t = app.theme
    x0 = 24.0
    y = 20.0
    gui.text_bold(win, x0, y, "Notifications", t.text, 24)
    y = y + 50.0
    w = 520.0
    if len(app.notifs) == 0:
        gui.text(win, x0, y + 10.0, "no notifications", t.text_dim, 14)
        return app
    row_h = 64.0
    gui.fill_round(win, x0, y, w, float(len(app.notifs)) * row_h + 12.0, 10.0, t.surface)
    for i in range(len(app.notifs)):
        n = app.notifs[i]
        rowy = y + 8.0 + float(i) * row_h
        draw_avatar(win, t, n.user, x0 + 34.0, rowy + 24.0, 16.0, false, false)
        # action label
        action = "liked your photo"
        if n.kind == "comment":
            action = "commented"
        elif n.kind == "follow":
            action = "started following you"
        elif n.kind == "mention":
            action = "mentioned you"
        draw_username(win, t, n.user, x0 + 60.0, rowy + 10.0, 14)
        gui.text(win, x0 + 60.0 + float(gui.text_width(win, n.user.username, 14)) + 8.0, rowy + 11.0, "{action}  {n.time_label}", t.text_dim, 13)
        if n.kind == "comment":
            gui.clip_push(win, x0 + 60.0, rowy + 32.0, w - 140.0, 18.0)
            gui.text(win, x0 + 60.0, rowy + 32.0, n.text, t.text_dim, 12)
            gui.clip_pop(win)
        # thumbnail chip
        pair = gradient_pair(n.thumb_seed)
        gui.fill_rect(win, x0 + w - 52.0, rowy + 10.0, 36.0, 36.0, pair.0)
        # follow button
        if n.kind == "follow":
            draw_button(win, t, x0 + w - 110.0, rowy + 12.0, 76.0, 30.0, "follow", true)
        if click_zone(win, x0 + 8.0, rowy, w - 16.0, row_h):
            app.screen = "profile"
            app.profile_user = n.user.username
    return app
