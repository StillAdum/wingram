# screen_reels — video posts from the real timeline
#
# Reels are the video posts the home timeline already carries. This build
# decodes stills only (the media backend is GDI+), so each reel shows its
# real poster frame, counts and caption, and links out for playback.

use gui
use "src/theme.strc"
use "src/types.strc": Post, count_format
use "src/ui_kit.strc"
use "src/imagepipe.strc"
use "src/app.strc"

func render(app: App) -> App:
    win = app.win
    t = app.theme
    s = app.scale
    x0 = 24.0 * s
    gw = float(gui.width(win))
    w = gw - x0 - 24.0 * s
    y = 16.0 * s
    gui.text_bold(win, x0, y, "Reels", t.text, 24.0 * s)
    gui.text(win, x0 + 90.0 * s, y + 8.0 * s, "video posts from your feed — tap the link to play", t.text_faint, 12.0 * s)
    y = y + 44.0 * s

    if len(app.reels) == 0:
        gui.text(win, x0, y + 20.0 * s, "no video posts in the loaded timeline yet", t.text_dim, 14.0 * s)
        return app

    card_w = 300.0 * s
    card_h = 420.0 * s
    gap = 16.0 * s
    cols = int(w / (card_w + gap))
    if cols < 1:
        cols = 1
    gh = float(gui.height(win))
    for i in range(len(app.reels)):
        p = app.reels[i]
        col = i % cols
        row = i / cols
        cx = x0 + float(col) * (card_w + gap)
        cy = y + float(row) * (card_h + gap)
        if cy > gh:
            break
        imagepipe.draw(app, p.photo_arg, cx, cy, card_w, card_h - 70.0 * s)
        # play badge
        gui.fill_round(win, cx + card_w / 2.0 - 26.0 * s, cy + (card_h - 70.0 * s) / 2.0 - 26.0 * s, 52.0 * s, 52.0 * s, 14.0 * s, lerp_color(0x000000, 0xFFFFFF, 0.2))
        gui.fill_rect(win, cx + card_w / 2.0 - 8.0 * s, cy + (card_h - 70.0 * s) / 2.0 - 12.0 * s, 3.5 * s, 24.0 * s, 0xFFFFFF)
        gui.fill_rect(win, cx + card_w / 2.0 + 4.0 * s, cy + (card_h - 70.0 * s) / 2.0 - 12.0 * s, 3.5 * s, 24.0 * s, 0xFFFFFF)
        # caption block
        gui.fill_round(win, cx, cy + card_h - 64.0 * s, card_w, 64.0 * s, 8.0 * s, t.surface)
        draw_username(win, t, p.user, cx + 12.0 * s, cy + card_h - 58.0 * s, 13.0 * s)
        gui.text(win, cx + 12.0 * s, cy + card_h - 40.0 * s, "{count_format(p.likes)} likes • {p.time_label}", t.text_dim, 12.0 * s)
        if p.link != "":
            gui.clip_push(win, cx + 12.0 * s, cy + card_h - 22.0 * s, card_w - 24.0 * s, 16.0 * s)
            gui.text(win, cx + 12.0 * s, cy + card_h - 22.0 * s, p.link, t.accent, 11.0 * s)
            gui.clip_pop(win)
    return app
