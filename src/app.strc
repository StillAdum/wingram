# app — the Wingram application state shared by all screens
#
# Screens are pure functions of App: they draw the current frame from state
# and return the (possibly updated) App. Lists and dicts inside App are
# refcounted, so the struct shell copy is cheap and element edits persist.
# Struct defaults must be constants in Still, so make_app() wires everything.

use "src/theme.strc"
use "src/types.strc": User, Post, NoteItem, Notif, Chat
use "src/songs.strc": Song, SongCatalog
use "src/adapters.strc": Adapter
use "src/mods_engine.strc": ModEngine

type App:
    win: int
    screen: str
    running: bool
    theme: Theme
    adapter: Adapter
    catalog: SongCatalog
    mods: ModEngine
    scale: float                 # ui scale = dpi/96 (set every frame)
    # login / session
    logged_in: bool
    login_error: str
    login_paste: str
    login_paste_focus: bool
    login_busy: bool
    login_hint: str
    # data
    me: User
    users: [User]
    posts: [Post]
    reels: [Post]
    notes: [NoteItem]
    notifs: [Notif]
    profile_owner: str
    profile_user: User
    profile_posts: [Post]
    profile_error: str
    search_results: [User]
    search_done: bool
    search_pending: str
    search_error: str
    # feed pagination
    feed_more: bool
    feed_next: str
    feed_loading_more: bool
    # image pipeline
    img_cache: {str: int}
    img_queue: [str]
    img_queued: {str: bool}
    img_fail: {str: bool}
    # ui state
    scroll: {str: int}
    search_query: str
    search_focus: bool
    compose_text: str
    compose_focus: bool
    compose_song: str
    song_query: str
    song_query_focus: bool
    picker_open: bool
    preview_song: str
    preview_playing: bool
    chat_index: int
    dm_text: str
    dm_focus: bool
    status_line: str
    toast: str
    toast_until: float
    settings_cfg: {str: str}
    settings_focus: str
    reload_requested: bool
    fetch_state: str             # idle | waiting | loading | ok | error
    fetch_error: str
    fetch_at: float
    notif_state: str             # idle | loading | ok | error
    notif_error: str

    func scroll_of(self, key: str) -> int:
        v = self.scroll.get(key, 0)
        return v

    func set_scroll(self, key: str, v: int):
        self.scroll[key] = v

    func toast_for(self, msg: str, secs: float):
        self.toast = msg
        self.toast_until = clock() + secs

func make_app(win: int) -> App:
    app = App(
        win,                                             # 1 win
        "feed",                                          # 2 screen
        true,                                            # 3 running
        make_theme(),                                    # 4 theme
        make_adapter("instagram"),                       # 5 adapter
        make_catalog(),                                  # 6 catalog
        ModEngine([], "mods"),                           # 7 mods
        1.0,                                             # 8 scale
        false,                                           # 9 logged_in
        "",                                              # 10 login_error
        "",                                              # 11 login_paste
        false,                                           # 12 login_paste_focus
        false,                                           # 13 login_busy
        "",                                              # 14 login_hint
        User("", "", "", "initials", "", "", 0, 0, false, true),   # 15 me
        [],                                              # 16 users
        [],                                              # 17 posts
        [],                                              # 18 reels
        [],                                              # 19 notes
        [],                                              # 20 notifs
        "",                                              # 21 profile_owner
        User("", "", "", "initials", "", "", 0, 0, false, false),  # 22 profile_user
        [],                                              # 23 profile_posts
        "",                                              # 24 profile_error
        [],                                              # 25 search_results
        false,                                           # 26 search_done
        "",                                              # 27 search_pending
        "",                                              # 28 search_error
        false,                                           # 29 feed_more
        "",                                              # 30 feed_next
        false,                                           # 31 feed_loading_more
        {},                                              # 32 img_cache
        [],                                              # 33 img_queue
        {},                                              # 34 img_queued
        {},                                              # 35 img_fail
        {},                                              # 36 scroll
        "",                                              # 37 search_query
        false,                                           # 38 search_focus
        "",                                              # 39 compose_text
        false,                                           # 40 compose_focus
        "",                                              # 41 compose_song
        "",                                              # 42 song_query
        false,                                           # 43 song_query_focus
        false,                                           # 44 picker_open
        "",                                              # 45 preview_song
        false,                                           # 46 preview_playing
        0,                                               # 47 chat_index
        "",                                              # 48 dm_text
        false,                                           # 49 dm_focus
        "",                                              # 50 status_line
        "",                                              # 51 toast
        0.0,                                             # 52 toast_until
        {},                                              # 53 settings_cfg
        "",                                              # 54 settings_focus
        false,                                           # 55 reload_requested
        "idle",                                          # 56 fetch_state
        "",                                              # 57 fetch_error
        0.0,                                             # 58 fetch_at
        "idle",                                          # 59 notif_state
        "")                                              # 60 notif_error
    return app
