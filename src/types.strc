# types — Wingram data models shared across screens and adapters
#
# All screens read/write these models. The data layer (adapters.strc) fills
# them from the real Instagram web API (sessionid login), so the UI only ever
# sees one shape. v0.2 removed the demo dataset: every post, user and avatar
# on screen comes from the logged-in account's real feed.

type User:
    id: str
    username: str
    full_name: str
    avatar_kind: str = "initials"   # "initials" or "url"
    avatar_arg: str = ""            # initials color seed or avatar URL
    bio: str = ""
    followers: int = 0
    following: int = 0
    verified: bool = false
    is_self: bool = false
    avatar_url: str = ""            # full-size profile picture URL
    post_count: int = 0

    func initials(self) -> str:
        if len(self.username) >= 2:
            return self.username[0:2].upper()
        if len(self.username) == 1:
            return self.username.upper()
        return "?"

type Post:
    id: str
    user: User
    caption: str
    likes: int
    comments: int
    time_label: str                 # "2h", "3d", "1w"
    liked: bool = false
    saved: bool = false
    photo_kind: str = "url"         # "url" | "gradient" (fallback while loading)
    photo_arg: str = ""             # image URL (photo_kind "url") or seed
    song_id: str = ""               # song attached locally (notes/songs feature)
    source: str = "instagram"       # instagram | fediverse
    link: str = ""                  # permalink when remote
    video: bool = false             # video post (poster shown)
    album: bool = false             # carousel post (first image shown)

type NoteItem:
    id: str
    user: User
    text: str
    song_id: str = ""               # attached song (Wingram songs-in-notes)
    time_left: str = "24h"          # notes live 24h on Instagram

type ChatMsg:
    id: str
    from_me: bool
    text: str
    time_label: str = "12:04"

type Chat:
    id: str
    user: User
    messages: [ChatMsg]
    unread: int = 0

type Notif:
    id: str
    kind: str                       # like | comment | follow | mention | other
    user: User
    text: str
    time_label: str = "1h"
    thumb_seed: str = "1"

# ------------------------------------------------------------- shared helpers

# relative label from a unix timestamp (Instagram taken_at is unix seconds)
func time_label_from_unix(t: int) -> str:
    now = int(clock())
    d = now - t
    if d < 0:
        d = 0
    if d < 60:
        return "{d}s"
    if d < 3600:
        return "{int(d / 60)}m"
    if d < 86400:
        return "{int(d / 3600)}h"
    if d < 604800:
        return "{int(d / 86400)}d"
    if d < 31536000:
        return "{int(d / 604800)}w"
    return "{int(d / 31536000)}y"

# return the index of the first occurrence of target in s, or -1
func find_sub(s: str, target: str) -> int:
    n = len(target)
    if n == 0 or n > len(s):
        return -1
    for i in range(len(s) - n + 1):
        if s[i:i + n] == target:
            return i
    return -1

# instagrapi-style: the ds_user_id is the part of the sessionid before the
# first ':' (the web cookie percent-encodes it as %3A, the mobile one uses ':')
func session_user_id(sessionid: str) -> str:
    out = ""
    for i in range(len(sessionid)):
        c = sessionid[i]
        if c >= "0" and c <= "9":
            out += c
        else:
            break
    return out

# normalize a pasted sessionid: accept the bare value, "sessionid=..." or a
# full "Cookie: sessionid=...; ds_user_id=..." header line
func clean_sessionid(raw: str) -> str:
    s = raw.trim()
    i = find_sub(s, "sessionid=")
    if i >= 0:
        s = s[i + 10:]
        j = find_sub(s, ";")
        if j >= 0:
            s = s[0:j]
    s = s.trim()
    for sep in ["%3A", "%3a"]:
        k = find_sub(s, sep)
        if k >= 0:
            s = s[0:k]
            break
    j2 = find_sub(s, ":")
    if j2 >= 0:
        s = s[0:j2]
    return s.trim()

func count_format(n: int) -> str:
    if n >= 1000000:
        m10 = n * 10 / 1000000
        return "{float(m10) / 10.0}M"
    if n >= 10000:
        k10 = n * 10 / 1000
        return "{float(k10) / 10.0}K"
    return "{n}"
